MRI_APP_NAME=MRI Agent
MRI_APP_VERSION=0.1.0
MRI_ENVIRONMENT=development
MRI_LOG_LEVEL=INFO
MRI_DATA_DIR=../data
MRI_CORS_ORIGINS=http://localhost:5173
MRI_MAX_UPLOAD_MB=512
MRI_ALLOWED_FILE_EXTENSIONS=.png,.jpg,.jpeg,.tif,.tiff,.bmp,.dcm,.dicom,.nii,.nii.gz
MRI_MODEL_DIR=../models
MRI_MONGODB_URL=mongodb://localhost:27017
MRI_MONGODB_DATABASE=mri_agent
MRI_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
